<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="caddy_ai2">

  <!-- ==================== ARGUMENTOS CON VALORES POR DEFECTO ==================== -->
  <xacro:arg name="is_simulation" default="true" />
  <xacro:arg name="enable_rviz" default="true" />
  <xacro:arg name="enable_gazebo" default="false" />
  <xacro:arg name="enable_ros2_control" default="false" />
  <xacro:arg name="use_gui" default="true" />
  <xacro:arg name="world_name" default="empty" />
  
  <!-- Propiedades físicas del robot (constantes) -->
  <xacro:property name="wheel_base_front" value="1.65" />
  <xacro:property name="wheel_base_rear" value="1.65" />
  <xacro:property name="track_width_front" value="1.0068" />
  <xacro:property name="track_width_rear" value="1.0068" />
  <xacro:property name="height_cg" value="0.2" />
  <xacro:property name="wheel_radius" value="0.28" />
  <xacro:property name="wheel_width" value="0.212" />
  <xacro:property name="wheel_turn_radius" value="0.2" />
  <xacro:property name="mass_chassis" value="1.14395" />
  <xacro:property name="mass_wheel" value="0.1" />
  <xacro:property name="collision_box_width" value="0.1" />
  <xacro:property name="collision_box_length" value="0.1" />
  <xacro:property name="collision_box_height" value="0.1" />

  <!-- Incluir archivos condicionalmente según argumentos -->
  <xacro:if value="$(arg enable_ros2_control)">
    <xacro:include filename="$(find caddy_ai2_description)/urdf/ros2_control.xacro" />
  </xacro:if>
  
  <xacro:if value="$(arg enable_gazebo)">
    <xacro:include filename="$(find caddy_ai2_description)/urdf/gazebo.xacro" />
  </xacro:if>

  <!-- Materiales -->
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.2 0.3 0.8 1.0"/>
  </material>

  <!-- ==================== BASE FOOTPRINT ==================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== BASE LINK (CHASIS) ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass_total}"/>
      <inertia ixx="0.095329" ixy="0" ixz="0"
               iyy="0.381317" iyz="0" izz="0.476646"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://caddy_ai2_description/meshes/stl/rbcar_chassis.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== RUEDAS TRASERAS (Tracción) ==================== -->
  <xacro:macro name="rear_wheel" params="side x_sign">
    <link name="wheel_${side}_back_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.043333" ixy="0.0" ixz="0.0" 
                 iyy="0.043333" iyz="0.0" izz="0.08"/>
      </inertial>
    </link>
    
    <joint name="wheel_${side}_back_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${side}_back_link"/>
      <origin xyz="-${wheelbase/2} ${x_sign * track_width/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:rear_wheel side="left" x_sign="1"/>
  <xacro:rear_wheel side="right" x_sign="-1"/>

  <!-- ==================== SISTEMA DE DIRECCIÓN DELANTERA ==================== -->
  <xacro:macro name="front_steering" params="side x_sign">
    <link name="${side}_front_hub_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.05"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.05"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" 
                 iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>
    
    <joint name="${side}_front_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${side}_front_hub_link"/>
      <origin xyz="${wheelbase/2} ${x_sign * track_width/2} 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.61" upper="0.61" effort="10" velocity="1.0"/>
    </joint>
    
    <link name="wheel_${side}_front_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.043333" ixy="0.0" ixz="0.0" 
                 iyy="0.043333" iyz="0.0" izz="0.08"/>
      </inertial>
    </link>
    
    <joint name="${side}_front_wheel_joint" type="continuous">
      <parent link="${side}_front_hub_link"/>
      <child link="wheel_${side}_front_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:front_steering side="left" x_sign="1"/>
  <xacro:front_steering side="right" x_sign="-1"/>

  <!-- ==================== CONFIGURACIÓN ROS2 CONTROL (condicional) ==================== -->
  <xacro:if value="$(arg enable_ros2_control)">
    <xacro:caddy_ai2_ros2_control 
      is_simulation="$(arg is_simulation)"/>
  </xacro:if>

  <!-- ==================== CONFIGURACIÓN GAZEBO (condicional) ==================== -->
  <xacro:if value="$(arg enable_gazebo)">
    <xacro:caddy_ai2_gazebo 
      wheel_radius="${wheel_radius}"
      wheel_width="${wheel_width}"/>
  </xacro:if>

</robot>